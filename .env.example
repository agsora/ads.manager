DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=change-me-to-a-random-32+-char-string
# Kunci OCR.space (opsional): fitur ambil NIK dari foto KTP dan No. KK dari foto KK di form WA Leads
OCR_SPACE_KEY=

# Login dengan kode OTP lewat email (Gmail SMTP). Pengirim: agsora.tech@gmail.com
# SMTP_PASS = App Password 16 karakter dari akun Gmail itu (Akun Google > Keamanan > Verifikasi 2 langkah > Sandi aplikasi).
# Tanpa SMTP_PASS, login tetap memakai password. OTP_ONLY=1 mematikan login password bila OTP aktif.
SMTP_PASS=
# SMTP_USER=agsora.tech@gmail.com
# OTP_ONLY=1
