DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=change-me-to-a-random-32+-char-string
# Kunci OCR.space (opsional): fitur ambil NIK dari foto KTP dan No. KK dari foto KK di form WA Leads
OCR_SPACE_KEY=

# Login dengan kode OTP lewat email (opsional). Pilih salah satu jalur pengiriman:
#  - SMTP Gmail: SMTP_USER=alamat@gmail.com, SMTP_PASS=App Password 16 karakter (Akun Google > Keamanan > Verifikasi 2 langkah > Sandi aplikasi)
#  - atau Resend: RESEND_API_KEY (+ EMAIL_FROM dengan domain yang sudah diverifikasi)
# Tanpa keduanya, login tetap memakai password. OTP_ONLY=1 mematikan login password bila OTP aktif.
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Ads Manager" <alamat@gmail.com>
# OTP_ONLY=1
